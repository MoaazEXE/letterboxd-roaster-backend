# Copy this file to `.env` and fill in real values.
# `.env` is gitignored; `.env.template` is committed so contributors know what to set.

# --- Gemini (Google AI Studio) ---
# Get a key at: https://aistudio.google.com/app/apikey
# If left blank the backend still works, but roasts will use a deterministic fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- TMDB (The Movie Database) ---
# Used to fetch movie poster images. Get a key at:
# https://www.themoviedb.org/settings/api
# If left blank, recommendations are returned without poster_url.
TMDB_API_KEY=

# --- Server ---
# In production, bind to 0.0.0.0 and let the platform inject $PORT.
HOST=127.0.0.1
PORT=8000

# --- CORS ---
# Comma-separated list of frontend origins allowed to call the API.
# Pydantic-settings parses this as a JSON array; either form below works:
#   ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# In production, set this to your deployed frontend URL, e.g.:
#   ALLOWED_ORIGINS=["https://letterboxd-roaster.vercel.app"]
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
